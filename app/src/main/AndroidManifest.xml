<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="jp.masaru.airwingsprobe" android:versionCode="3" android:versionName="0.3.0">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application android:label="AirWingsボタン検証" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:debuggable="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LogActivity" android:exported="false" />
        <service android:name=".ProbeService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
